# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
# Fetch from Google Drive (CSV import): a public browser API key used by Google Picker. Restrict it
# to the Google Picker API and this app's HTTP referrers. See DEVELOPMENT.md.
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# Save to Drive: public client ID of a "Web application" OAuth client. Users sign in with
# Google in the browser; no secret or token is stored. See DEVELOPMENT.md.
GOOGLE_CLIENT_ID=

# Slack status report channel, separate from the review channel (SLACK_CHANNEL_ID). Invite the bot to it.
SLACK_STATUS_CHANNEL_ID=
